#!/usr/bin/env bash
# The one entry point for this project's checks. CI, wf and people all call these names.
# Fill in each command at the Design stage; keep the names.
set -uo pipefail
cd "$(dirname "$0")"
cmd="${1:-}"; shift || true
case "$cmd" in
  test)     # all tests; with file arguments, only those
    python3 -m pytest -q "$@"; rc=$?
    [ $# -eq 0 ] && [ $rc -eq 5 ] && rc=0   # an empty suite passes; an empty named file does not
    exit $rc ;;
  check)    # everything CI runs, except the scan
    ./run test && { [ ! -d src ] || python3 -m compileall -q src; } ;;
  scan)     # static security scan
    [ ! -d src ] || python3 -m bandit -q -r src ;;
  dev)      # run the app from the working tree
    set -a; . ./deploy.env; set +a; sh -c "exec $START" ;;
  smoke)    # start of every session: does the app start and answer its health check?
    scripts/deploy.sh smoke ;;
  deploy)   # release HEAD; rolls back itself on a failed health check
    scripts/deploy.sh deploy ;;
  rollback) scripts/deploy.sh rollback ;;
  health)   scripts/deploy.sh health ;;
  *) echo "usage: ./run test|check|scan|dev|smoke|deploy|rollback|health"; exit 2 ;;
esac
